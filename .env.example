# Copiez ce fichier en ".env" (même dossier que main.py) puis renseignez vos valeurs.
# Le fichier ".env" ne doit JAMAIS être publié (il est exclu par .gitignore).

# --- ESSE AI (facultatif : sans clé, l'appli utilise sa simulation locale) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modèles GPT-5 / série o : décommentez les deux lignes suivantes
# OPENAI_TOKEN_PARAM=max_completion_tokens
# OPENAI_TEMPERATURE=
AI_MONTHLY_BUDGET_USD=5
# Tarifs en USD par million de jetons : à ajuster selon le modèle choisi
AI_PRICE_IN_PER_M=0.15
AI_PRICE_OUT_PER_M=0.60

# --- Serveur ---
# ESSE_DB_PATH=data/esse_fleet.sqlite3
# HTML_PATH=ESSE-Fleet.html
# ESSE_SESSION_DAYS=30
# TRUST_PROXY=1          # uniquement derrière un proxy de confiance (Render, Nginx, Cloudflare)
# ALLOWED_ORIGINS=https://votre-domaine.com   # inutile si le HTML est servi par ce même serveur
